# Copy to .env and fill in. The .env file itself never goes into git.

# PostgreSQL connection string
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/memovo?schema=public"

# Signing key for the access tokens. Any long random string.
JWT_SECRET="change-me-to-a-long-random-string"
JWT_EXPIRES_IN="7d"

# Where the API listens, and which origins may call it (comma separated)
PORT=4000
FRONTEND_ORIGIN="http://localhost:3000,http://localhost:3100"

# Photo storage
UPLOAD_DIR="./uploads"
# The API's own public address; photo URLs are built from it
PUBLIC_URL="http://localhost:4000"

# Contact form mail. Leave SMTP_HOST empty and the mails are logged instead of sent.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Memovo <hello@memovo.com>"
# Where a new contact form submission is announced
LEAD_NOTIFY_TO=""
